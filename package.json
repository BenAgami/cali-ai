{
  "name": "cali-ai",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "comment": "vitest itself does not hoist to the root, so its coverage provider must stay beside it in apps/api/node_modules or it cannot resolve `vitest`.",
    "nohoist": [
      "**/@vitest/coverage-v8"
    ]
  },
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@1.22.19",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "knip": "knip",
    "deps:lint": "syncpack lint",
    "deps:fix": "syncpack fix"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "eslint": "^9",
    "globals": "^15",
    "knip": "^6.38.0",
    "prettier": "^3.1.1",
    "syncpack": "^15.3.3",
    "tsup": "^8.5.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  }
}
