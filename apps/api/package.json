{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "cross-env NODE_ENV=test vitest run --project integration",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "check-types": "tsc --noEmit",
    "build": "tsc --noEmit && tsup",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "@repo/common": "*",
    "@repo/db": "*",
    "@scalar/express-api-reference": "^0.10.6",
    "@smithy/node-http-handler": "^4.5.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.71.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^24",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "4.0.18",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "vitest": "^4.0.17"
  }
}
