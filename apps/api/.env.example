PORT=3000
SERVICE_NAME="api" # api | worker — set to worker in the BullMQ worker's start script
LOG_LEVEL="info" # optional override: trace | debug | info | warn | error | fatal | silent
DATABASE_URL="postgresql://username:password@localhost:5434/schema_name?schema=public"
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="1h"

# Redis (BullMQ job queue). Keep tests on a separate database index
# (e.g. REDIS_URL="redis://localhost:6379/1" in .env.test) so a running dev
# server cannot consume the integration tests' jobs.
REDIS_URL="redis://localhost:6379"

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:8081"

# Form analysis pipeline (defaults shown). ANALYSIS_STUCK_TIMEOUT_MS must exceed
# attempts x LLM timeout + exponential backoff + 15s, and
# ANALYSIS_STUCK_TIMEOUT_MS + ANALYSIS_REAPER_INTERVAL_MS must be <= 180000
# (3-minute ceiling), or the API refuses to start.
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_BACKOFF_DELAY_MS=2000
ANALYSIS_LLM_TIMEOUT_MS=40000
ANALYSIS_STUCK_TIMEOUT_MS=150000
ANALYSIS_REAPER_INTERVAL_MS=15000

# Cloudflare R2 (avatar storage)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_r2_bucket_name"
R2_PUBLIC_DOMAIN="your_r2_public_domain"
