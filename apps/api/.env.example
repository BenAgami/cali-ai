PORT=3000
SERVICE_NAME="api" # api | worker — set to worker in the BullMQ worker's start script
LOG_LEVEL="info" # optional override: trace | debug | info | warn | error | fatal | silent
DATABASE_URL="postgresql://username:password@localhost:5434/schema_name?schema=public"
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="1h"

# Redis (BullMQ job queue). Dev runs on :6379, tests on :6380 (redis-test).
REDIS_URL="redis://localhost:6379"

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:8081"

# Form analysis pipeline (defaults shown). Cross-field limits are enforced in
# src/config/env.ts; the API refuses to start if they're violated.
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_BACKOFF_DELAY_MS=2000
ANALYSIS_LLM_TIMEOUT_MS=40000
ANALYSIS_STUCK_TIMEOUT_MS=150000
ANALYSIS_REAPER_INTERVAL_MS=15000

# Cloudflare R2 (avatar storage)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_r2_bucket_name"
R2_PUBLIC_DOMAIN="your_r2_public_domain"
