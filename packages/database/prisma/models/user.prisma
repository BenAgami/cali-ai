model User {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(dbgenerated("uuidv7()")) @db.Uuid

  email    String @unique
  username String @unique
  fullName String @map("full_name")
  password String @map("password_hash")

  role Role @default(USER)

  avatarUrl String? @map("avatar_url")

  experienceLevel ExperienceLevel? @map("experience_level")

  aiConsentAt      DateTime? @map("ai_consent_at")
  aiConsentVersion String?   @map("ai_consent_version") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bodyMetrics        BodyMetric[]
  goals              UserGoal[]
  workoutSessions    WorkoutSession[]
  userMilestones     UserMilestone[]
  workouts           Workout[]
  workoutLogs        WorkoutLog[]
  refreshTokens      RefreshToken[]
  workoutGenerations WorkoutGeneration[]

  @@map("users")
}
