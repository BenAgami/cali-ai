model AnalysisRetry {
  id Int @id @default(autoincrement())

  recordedSet   RecordedSet @relation(fields: [recordedSetId], references: [id], onDelete: Cascade)
  recordedSetId Int         @map("recorded_set_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([recordedSetId, createdAt], map: "idx_analysis_retries_recorded_set_created")
  @@map("analysis_retries")
}
